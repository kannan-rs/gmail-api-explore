NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://localhost:5173

DATABASE_URL=postgresql://localhost:5432/gmail_send_tracker
TEST_DATABASE_URL=postgresql://localhost:5432/gmail_send_tracker_test

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: pre-provisioned refresh token for automatic connection.
# Run `npm run auth:token` once to obtain it, then restart the app.
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

TOKEN_ENCRYPTION_KEY=
COOKIE_SECRET=

DAILY_SEND_LIMIT=100
MAX_ATTACHMENT_BYTES=20971520
MAX_ATTACHMENTS=10
GMAIL_API_TIMEOUT_MS=30000
LIVE_TEST_RECIPIENT=
LOG_LEVEL=info

# Tracking links must be reachable by recipients. Use an HTTPS tunnel or production URL.
# Leave blank to fall back to APP_BASE_URL (localhost works only for local tests).
PUBLIC_BASE_URL=
TRACKING_ENABLED=true
TRACKING_PIXEL_ENABLED=true
TRACKING_ACK_ENABLED=true
READ_RECEIPT_REQUESTED=true
# Empty disables the webhook endpoint.
TRACKING_WEBHOOK_SECRET=
TRACKING_SYNC_DAYS=7
# Automatic Gmail DSN/MDN/reply sync interval. Set 0 to disable.
TRACKING_SYNC_INTERVAL_MINUTES=30
